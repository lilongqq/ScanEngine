            elif e.response['Error']['Code'] == 'OwnershipControlsNotFoundError':
                return self.json_data({'code': 12715404, 'message': e.response['Error']['Message'], 'data': []})
            elif e.response['Error']['Code'] == 'NoSuchAccessPoint':
                return self.json_data({'code': 12716404, 'message': e.response['Error']['Message'], 'data': []})
            elif e.response['Error']['Code'] == 'MethodNotAllowed':
                return self.json_data({'code': 12701405, 'message': e.response['Error']['Message'], 'data': []})
            elif e.response['Error']['Code'] == 'AccessPointAlreadyOwnedByYou':
                return self.json_data({'code': 12701409, 'message': e.response['Error']['Message'], 'data': []})
            elif e.response['Error']['Code'] == 'BucketAlreadyExists':
                return self.json_data({'code': 12702409, 'message': e.response['Error']['Message'], 'data': []})
            elif e.response['Error']['Code'] == 'BucketAlreadyOwnedByYou':
                return self.json_data({'code': 12703409, 'message': e.response['Error']['Message'], 'data': []})
            elif e.response['Error']['Code'] == 'BucketNotEmpty':
                return self.json_data({'code': 12704409, 'message': e.response['Error']['Message'], 'data': []})
            elif e.response['Error']['Code'] == 'ClientTokenConflict':
                return self.json_data({'code': 12705409, 'message': e.response['Error']['Message'], 'data': []})
            elif e.response['Error']['Code'] == 'ConditionalRequestConflict':
                return self.json_data({'code': 12706409, 'message': e.response['Error']['Message'], 'data': []})
            elif e.response['Error']['Code'] == 'InvalidBucketState':
                return self.json_data({'code': 12707409, 'message': e.response['Error']['Message'], 'data': []})
            elif e.response['Error']['Code'] == 'OperationAborted':
                return self.json_data({'code': 12708409, 'message': e.response['Error']['Message'], 'data': []})
            elif e.response['Error']['Code'] == 'RestoreAlreadyInProgress':
                return self.json_data({'code': 12709409, 'message': e.response['Error']['Message'], 'data': []})
            elif e.response['Error']['Code'] == 'MissingContentLength':
                return self.json_data({'code': 12701411, 'message': e.response['Error']['Message'], 'data': []})
            elif e.response['Error']['Code'] == 'PreconditionFailed':
                return self.json_data({'code': 12701412, 'message': e.response['Error']['Message'], 'data': []})
            elif e.response['Error']['Code'] == 'RequestIsNotMultiPartContent':
                return self.json_data({'code': 12702412, 'message': e.response['Error']['Message'], 'data': []})
            elif e.response['Error']['Code'] == 'InvalidRange':
                return self.json_data({'code': 12701416, 'message': e.response['Error']['Message'], 'data': []})
            elif e.response['Error']['Code'] == 'InternalError':
                return self.json_data({'code': 12701500, 'message': e.response['Error']['Message'], 'data': []})
            elif e.response['Error']['Code'] == 'NotImplemented':
                return self.json_data({'code': 12701501, 'message': e.response['Error']['Message'], 'data': []})
            elif e.response['Error']['Code'] == 'ServiceUnavailable':
                return self.json_data({'code': 12701503, 'message': e.response['Error']['Message'], 'data': []})
            elif e.response['Error']['Code'] == 'SlowDown':
                return self.json_data({'code': 12702503, 'message': e.response['Error']['Message'], 'data': []})
            elif e.response['Error']['Code'] == '503 SlowDown':
                return self.json_data({'code': 12703503, 'message': e.response['Error']['Message'], 'data': []})
            else:
                return self.json_data({'code': 12700000, 'message': e.response['Error']['Message'], 'data': []})
        except OSError as e:
            self.logger.error(traceback.format_exc())
            return self.json_data({'code': e.errno, 'message': e.strerror, 'data': []})
        except Exception as e:
            self.logger.error(traceback.format_exc())
            return self.json_data({'code': 5000, 'message': '服务器内部异常', 'data': []})

    @auth.login_required
    def download(self):
        try:
            req_body = request.json
            # [DEBUG-SEEYON] web 侧收到请求数据
            self.logger.info('[DEBUG-SEEYON][download] web 收到请求: cls=%s, node_keys=%s',
                             req_body.get('cls') if req_body else None,
                             list(req_body.keys()) if req_body else None)
            self.logger.info('[DEBUG-SEEYON][download] 完整请求体: %s', req_body)
            node = req_body
            client = get_class(
                classmap.protocol.get(
                    node['cls']
                )
            )(
                **node['auth']
            )
            self.logger.info('[DEBUG-SEEYON][download] 客户端实例化成功: %s', type(client).__name__)
            f = client.get_file(node)
            self.logger.info('[DEBUG-SEEYON][download] get_file 返回成功, node=%s', {k: v for k, v in node.items() if k != 'auth'})
            return send_file(f, mimetype='application/octet-stream')
        except Exception:
            self.logger.error('[DEBUG-SEEYON][download] 异常: %s', traceback.format_exc())
            return self.json_data({'code': 5000, 'message': '服务器内部异常', 'data': []}, http_code=500)

    def separate(self):
        try:
            node = request.json
            self.logger.info(node)
            # 默认不打开占位符
            placeholder = node.get('placeholder', 0)
            try:
                src_client = get_class(
                    classmap.protocol.get(
                        node['cls']
                    )
                )(
                    **node['auth']
                )
            except:
                self.logger.error(traceback.format_exc())
                return self.json_data({
                    'code': 4000,
                    'message': '服务器连接失败'
                })
            sep_path = node.get('sep_path')
            self.logger.info('sep_path:')
            self.logger.info(sep_path)

            # download file
            try:
                f = src_client.get_file(node)
            except:
                self.logger.error(traceback.format_exc())
                return self.json_data({
                    'code': 4000,
                    'message': '获取源文件失败'
                })
            if node['isEncrypt'] == 1:
                try:
                    cipher = sm4.CryptSM4()
                    key = bytes.fromhex(self.variables.sm4_key['key'])
                    cipher.set_key(key, sm4.SM4_ENCRYPT)
                    dist = io.BytesIO()
                    cipher_data = cipher.crypt_ecb(f.read())
                    dist.write(cipher_data)
                    f.seek(0)
                    dist.seek(0)
                    f = dist
                    self.logger.info('{}SM4加密成功'.format(sep_path))
                except:
                    self.logger.error('{}SM4加密失败'.format(sep_path))
                    self.logger.error(traceback.format_exc())
            remote = node.get('remote', 1)

            if remote:
                try:
                    self.logger.info('sepCls:')
                    self.logger.info(node['sepCls'])
                    self.logger.info(node['sepAuth'])
                    target_client = get_class(
                        classmap.protocol.get(node['sepCls'])
                    )(
                        **node['sepAuth']
                    )
                    target_client.store_file(node, f)
                except:
                    self.logger.error(traceback.format_exc())
                    return self.json_data({
                        'code': 4000,
                        'message': '远程隔离服务器连接失败'
                    })
            else:
                src_client.store_file(node, f)

            if placeholder:
                src_client.empty_file(node)
            else:
                src_client.delete_file(node)
            return self.json_data({
                'code': 2000,
                'message': 'succeed'
            })
        except Exception:
            self.logger.error(traceback.format_exc())
            return self.json_data({'code': 5000, 'message': '服务器内部异常'})

    def restore(self):
        try:
            node = request.json
            self.logger.info('before change node:')
            self.logger.info(node)
            # 交换节点信息
            node['auth'], node['sepAuth'] = node['sepAuth'], node['auth']
            node['cls'], node['sepCls'] = node['sepCls'], node['cls']
            node['path'], node['sepPath'] = node['sepPath'] + \
                '/' + node['name'], os.path.split(node['path'])[0]
            self.logger.info('after change node:')
            self.logger.info(node)
            try:
                src_client = get_class(
                    classmap.protocol.get(node['cls'])
                )(
                    **node['auth']
                )
            except:
                self.logger.error(traceback.format_exc())
                return self.json_data({
                    'code': 4000,
                    'message': '服务器连接失败'
                })
            sep_path = node.get('sep_path')
            self.logger.info('sep_path:')
            self.logger.info(sep_path)

            # download file
            try:
                f = src_client.get_file(node)
            except:
                self.logger.error(traceback.format_exc())
                return self.json_data(
                    {
                        'code': 4000,
                        'message': '获取源文件失败'
                    }
                )

            if node['isEncrypt'] == 1:
                try:
                    decipher = sm4.CryptSM4()
                    key = bytes.fromhex(self.variables.sm4_key['key'])
                    decipher.set_key(key, sm4.SM4_DECRYPT)
                    dist = io.BytesIO()
                    decipher_data = decipher.crypt_ecb(f.read())
                    dist.write(decipher_data)
                    f.seek(0)
                    dist.seek(0)
                    f = dist
                    self.logger.info('{}SM4解密成功'.format(sep_path))
                except:
                    self.logger.error('{}SM4解密失败'.format(sep_path))
                    self.logger.error(traceback.format_exc())

            remote = node.get('remote', 1)
            if remote:
                try:
                    self.logger.info('sepCls:')
                    self.logger.info(node['sepCls'])
                    self.logger.info(node['sepAuth'])
                    target_client = get_class(
                        classmap.protocol.get(
                            node['sepCls']
                        )
                    )(
                        **node['sepAuth']
                    )
                    target_client.store_file(node, f)
                except:
                    self.logger.error(traceback.format_exc())
                    return self.json_data({
                        'code': 4000,
                        'message': '远程隔离服务器连接失败'
                    })
            else:
                src_client.store_file(node, f)

            # 还原直接删除隔离区的文件
            src_client.delete_file(node)
            return self.json_data({
                'code': 2000,
                'message': 'succeed'
            })
        except Exception:
            self.logger.error(traceback.format_exc())
            return self.json_data({'code': 5000, 'message': '服务器内部异常'})

    @auth.login_required
    def operate_job(self):
        try:
            definition = request.json
            # [DEBUG-SEEYON] web 侧下发的完整任务定义
            self.logger.info('[DEBUG-SEEYON][operate_job] 收到任务定义: identity=%s, op=%s, cls=%s',
                             definition.get('identity'), definition.get('op'), definition.get('cls'))
            self.logger.info('[DEBUG-SEEYON][operate_job] 完整 definition: %s', definition)
            op = definition.get('op', 'create')
            identity = definition.get('identity')
            if op == 'manual_pause':
                self.redis.hset(
                    self.variables.redis['event'],
                    identity,
                    0
                )
                self.redis.publish(
                    self.variables.redis['event'],
                    identity
                )
            elif op == 'manual_resume':
                self.redis.hset(
                    self.variables.redis['event'],
                    identity,
                    1
                )
                self.redis.publish(
                    self.variables.redis['event'],
                    identity
                )
            elif op == 'create':
                func = getattr(self.strategy_factory, op)
                func(definition)
            elif op == 'secondary':
                func = getattr(self.strategy_factory, op)
                func(definition)
            else:
                func = getattr(self.strategy_factory, op)
                func(identity)
            return self.json_data({
                'code': 2000,
                'message': 'succeed'
            })
        except Exception:
            self.logger.error(traceback.format_exc())
            return self.json_data({'code': 5000, 'message': '服务器内部异常'})

    @auth.login_required
    def count_size(self):
        try:
            data = request.json
            self.logger.info(data)
            identity = data.get('identity', None)
            stats_name = ':'.join([self.variables.redis['stats'], identity])
            count, db_records, binary_count, size, task_id, status = self.redis.hmget(
                stats_name,
                ['count', 'db_records', 'binary_count', 'size', 'task_id', 'status']
            )
            if count:
                count = int(count)
            if db_records:
                db_records = int(db_records)
            if binary_count:
                binary_count = int(binary_count)
            if size:
                size = int(size)
            if task_id:
                task_id = str(task_id, encoding='utf-8')
            if status:
                status = str(status, encoding='utf-8')

            return self.json_data(
                {
                    'data': {
                        'count': count,
                        'size': size,
                        'db_records': db_records,
                        'binary_count': binary_count,
                        'task_id': task_id,
                        'status': status
                    },
                    'code': 2000,
                    'message': 'succeed'
                }
            )
        except Exception:
            self.logger.error(traceback.format_exc())
            return self.json_data({'code': 5000, 'message': '服务器内部异常'}, http_code=500)

    def run(self):
        self.app.run(
            host="0.0.0.0",
            port=8888,
            use_reloader=False,
            ssl_context=(
                os.path.join(self.variables.certs, 'server-cert.pem'),
                os.path.join(self.variables.certs, 'server-key.pem')
            )
        )
